# 复制为 .env 后填写（程序本身不自动加载 .env，请用 export 或手动注入）
# 不配置也能跑：会自动降级到离线 Mock 引擎

# 必填：任意 OpenAI 兼容服务的 Key
OPENAI_API_KEY=

# 选填：接口地址，默认 https://api.openai.com/v1
# DeepSeek:   https://api.deepseek.com/v1
# Ollama:     http://localhost:11434/v1
# 阿里百炼:   https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# 选填：模型名称
MINIAGENT_MODEL=gpt-4o-mini

# 选填：文件工具的沙箱目录（默认 ./.workspace）
MINIAGENT_SANDBOX=

# 选填：待办数据库路径（默认 ./.workspace/todo.db）
MINIAGENT_TODO_DB=
